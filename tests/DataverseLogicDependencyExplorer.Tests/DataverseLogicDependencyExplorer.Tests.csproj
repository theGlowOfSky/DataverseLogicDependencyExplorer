<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.2.2" />
    <PackageReference Include="MSTest.TestFramework" Version="3.2.2" />
    <!--
      The plugin project excludes host assemblies from its output (PrivateAssets=all), so the tests reference the Dataverse SDK
      themselves (same version the XrmToolBox package resolves) to build late-bound entities and fake the organization service.
    -->
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.59" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only host-independent logic (analysis engine, parsers, Excel writer) is under test. -->
    <ProjectReference Include="..\..\src\DataverseLogicDependencyExplorer\DataverseLogicDependencyExplorer.csproj" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>
